<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="planetary_landing">

    <!-- Phase 26: Mars-like sun, low angle, harsh shadows -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0.4 0.4</pose>
      <diffuse>0.9 0.8 0.7 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Mars atmosphere: dim ambient, orange sky -->
    <scene>
      <ambient>0.3 0.2 0.15 1</ambient>
      <background>0.55 0.35 0.2 1</background>
      <grid>false</grid>
      <shadows>true</shadows>
    </scene>

    <!-- Phase 26: Ground plane — solid Mars color, grid disabled -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.38 0.22 1</ambient>
            <diffuse>0.62 0.44 0.28 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Phase 27: 11 scaled obstacles (3-7m tall for visibility at 5m drone height) -->

    <!-- Boulder 1: large ellipsoid -->
    <model name="boulder_1">
      <static>true</static>
      <pose>-8 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
          <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Boulder 2: elongated ellipsoid (approximated with scaled sphere) -->
    <model name="boulder_2">
      <static>true</static>
      <pose>7 -9 1.0 0.2 0.1 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>1.5</radius></sphere></geometry>
          <material><ambient>0.48 0.33 0.18 1</ambient><diffuse>0.52 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Large sphere -->
    <model name="sphere_large">
      <static>true</static>
      <pose>-5 8 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>2.0</radius></sphere></geometry>
          <material><ambient>0.45 0.30 0.18 1</ambient><diffuse>0.50 0.35 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Spire cylinder: r=0.8, h=6m -->
    <model name="spire">
      <static>true</static>
      <pose>4 5 3.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.8</radius><length>6.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.8</radius><length>6.0</length></cylinder></geometry>
          <material><ambient>0.42 0.28 0.16 1</ambient><diffuse>0.48 0.33 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Pillar cylinder: r=1.2, h=7m -->
    <model name="pillar">
      <static>true</static>
      <pose>-11 3 3.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>1.2</radius><length>7.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>1.2</radius><length>7.0</length></cylinder></geometry>
          <material><ambient>0.50 0.34 0.20 1</ambient><diffuse>0.56 0.40 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Flat slab: 5x3x1.5m -->
    <model name="slab">
      <static>true</static>
      <pose>9 7 0.75 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5.0 3.0 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5.0 3.0 1.5</size></box></geometry>
          <material><ambient>0.52 0.36 0.22 1</ambient><diffuse>0.58 0.42 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tilted fallen cylinder -->
    <model name="fallen_cylinder">
      <static>true</static>
      <pose>-3 -11 0.6 1.5 0.3 0.8</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.7</radius><length>4.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.7</radius><length>4.0</length></cylinder></geometry>
          <material><ambient>0.46 0.31 0.18 1</ambient><diffuse>0.52 0.36 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rock wall / ridge: 14x1.5x4m -->
    <model name="rock_wall">
      <static>true</static>
      <pose>0 -13 2.0 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>14.0 1.5 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>14.0 1.5 4.0</size></box></geometry>
          <material><ambient>0.48 0.32 0.18 1</ambient><diffuse>0.54 0.38 0.22 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small rock cluster 1 -->
    <model name="small_rock_1">
      <static>true</static>
      <pose>6 -4 0.4 0.1 0.2 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
          <material><ambient>0.44 0.30 0.17 1</ambient><diffuse>0.50 0.35 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small rock cluster 2 -->
    <model name="small_rock_2">
      <static>true</static>
      <pose>7 -3 0.3 0.0 0.1 1.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>0.44 0.30 0.17 1</ambient><diffuse>0.50 0.35 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Small rock cluster 3 -->
    <model name="small_rock_3">
      <static>true</static>
      <pose>5.5 -5 0.35 0.2 0.0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.6</radius></sphere></geometry>
          <material><ambient>0.44 0.30 0.17 1</ambient><diffuse>0.50 0.35 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
