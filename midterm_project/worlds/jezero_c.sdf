<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="jezero_c">

    <!-- Physics: standard real-time, 1ms step -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core plugins (required for Gazebo Harmonic simulation) -->
    <!-- Using dartsim default physics engine: mesh collision is the reference
         implementation path, well-tested across all gz-physics-7 engines.
         No <engine> override needed. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Mars sky: butterscotch ambient, low dust -->
    <scene>
      <ambient>0.55 0.35 0.25 1</ambient>
      <background>0.75 0.55 0.40 1</background>
      <grid>false</grid>
    </scene>

    <!-- Sun: low angle to get good shadowing on the terrain -->
    <light name="mars_sun" type="directional">
      <pose>0 0 50 0 0.7 0.3</pose>
      <diffuse>0.95 0.85 0.75 1</diffuse>
      <specular>0.4 0.35 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 -0.3 -0.8</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Jezero_C terrain as triangulated mesh.
         Source: 65x65 Float32 DTM converted via dtm_to_obj.py
         4225 vertices, 8192 triangles, 64x64 m extent, 0-3.08 m relief.
         UV-mapped to ortho texture (Option A: full-terrain mapping). -->
    <model name="jezero_terrain">
      <static>true</static>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <mesh>
              <uri>file://jezero_c/terrain_mesh/jezero_terrain.obj</uri>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>3.0</mu>
                <mu2>3.0</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <max_vel>0.01</max_vel>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <mesh>
              <uri>file://jezero_c/terrain_mesh/jezero_terrain.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Mission entities (Phase 5 integration, Apr 18 2026) -->
    <!-- drone, skids resting on terrain (terrain_z=0.023, clearance=0.2) -->
    <include>
      <uri>model://flying_drone</uri>
      <name>drone</name>
      <pose>5 -20 0.223 0 0 0</pose>
    </include>
    <!-- rover, wheels resting on terrain (terrain_z=0.041, clearance=0.12) -->
    <include>
      <uri>model://mars_rover</uri>
      <name>rover</name>
      <pose>5 -18.5 0.161 0 0 0</pose>
    </include>
    <!-- habitat dome, sits on terrain (terrain_z=0.230) -->
    <include>
      <uri>model://habitat_dome</uri>
      <name>habitat_dome</name>
      <pose>20 -20 0.230 0 0 0</pose>
    </include>

    <!-- Phase 3: Rock models for TRN feature enrichment (Apr 20 2026).
         6 rocks alternating left/right of rover path at rig y=+/-1.5 to -2.
         Height 0.45-0.52m exceeds the 0.25m rangefinder detection threshold,
         so the drone marks them occupied during survey, giving TRN a richer
         likelihood field to match against.
         Poses: (world_x, world_y, terrain_z + rock_h/2 + 0.02) 0 0 yaw -->
    <model name="rock_a">
      <static>true</static>
      <pose>9.0 -18.0 0.323 0 0 0.0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.55 0.40 0.45</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.55 0.40 0.45</size></box></geometry>
          <material>
            <ambient>0.42 0.28 0.18 1</ambient>
            <diffuse>0.52 0.35 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_b">
      <static>true</static>
      <pose>11.0 -22.0 0.368 0 0 0.5</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.60 0.35 0.50</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.60 0.35 0.50</size></box></geometry>
          <material>
            <ambient>0.44 0.30 0.19 1</ambient>
            <diffuse>0.54 0.37 0.23 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_c">
      <static>true</static>
      <pose>13.0 -18.0 0.372 0 0 1.1</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.50 0.45 0.40</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.50 0.45 0.40</size></box></geometry>
          <material>
            <ambient>0.40 0.27 0.17 1</ambient>
            <diffuse>0.50 0.34 0.21 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_d">
      <static>true</static>
      <pose>15.0 -22.0 0.360 0 0 0.3</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.65 0.38 0.48</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.65 0.38 0.48</size></box></geometry>
          <material>
            <ambient>0.43 0.29 0.18 1</ambient>
            <diffuse>0.53 0.36 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_e">
      <static>true</static>
      <pose>17.0 -18.0 0.459 0 0 0.8</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.48 0.42 0.52</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.48 0.42 0.52</size></box></geometry>
          <material>
            <ambient>0.41 0.28 0.17 1</ambient>
            <diffuse>0.51 0.35 0.21 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_f">
      <static>true</static>
      <pose>18.0 -22.0 0.451 0 0 1.4</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.58 0.44 0.46</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.58 0.44 0.46</size></box></geometry>
          <material>
            <ambient>0.43 0.29 0.18 1</ambient>
            <diffuse>0.53 0.36 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
