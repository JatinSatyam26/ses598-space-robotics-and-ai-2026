<?xml version="1.0" ?>
<model>
  <name>flying_drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    X500 quadcopter with MulticopterVelocityControl (Twist commands),
    3 cameras (downward mono, front RGB, front depth), and OdometryPublisher.
    Accepts velocity commands on flying_drone/gazebo/command/twist.
    Publishes odometry on model/flying_drone/odometry.
  </description>
</model>
