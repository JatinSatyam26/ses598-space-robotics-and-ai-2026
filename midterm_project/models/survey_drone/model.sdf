<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="survey_drone">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.029125</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.029125</iyy>
          <iyz>0</iyz>
          <izz>0.055225</izz>
        </inertia>
      </inertial>

      <!-- Main body box -->
      <visual name="body_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.30 0.30 0.08</size></box></geometry>
        <material><ambient>0.3 0.3 0.7 1</ambient><diffuse>0.3 0.3 0.7 1</diffuse></material>
      </visual>

      <!-- Arms -->
      <visual name="arm_x_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.80 0.03 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="arm_y_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.03 0.80 0.03</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Motor discs -->
      <visual name="motor1_visual">
        <pose>0.35 0.35 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="motor2_visual">
        <pose>-0.35 0.35 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
      </visual>
      <visual name="motor3_visual">
        <pose>0.35 -0.35 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.2 0.8 0.2 1</ambient><diffuse>0.2 0.8 0.2 1</diffuse></material>
      </visual>
      <visual name="motor4_visual">
        <pose>-0.35 -0.35 0.02 0 0 0</pose>
        <geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
      </visual>

      <!-- Collision (simplified box) -->
      <collision name="body_collision">
        <geometry><box><size>0.80 0.80 0.10</size></box></geometry>
      </collision>

      <!-- DOWNWARD MONO CAMERA: pitch -90 deg (pointing down) -->
      <sensor name="mono_camera" type="camera">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>800</width><height>600</height><format>RGB_INT8</format></image>
          <clip><near>0.1</near><far>200</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>mono_camera</topic>
      </sensor>

      <!-- FRONT RGB CAMERA: tilted 20 deg down -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.15 0 0 0 0.349 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>800</width><height>600</height><format>RGB_INT8</format></image>
          <clip><near>0.1</near><far>200</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>rgb_camera</topic>
      </sensor>

      <!-- FRONT DEPTH CAMERA: tilted 20 deg down -->
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.15 0 0.02 0 0.349 0</pose>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
        <topic>depth_camera</topic>
      </sensor>

    </link>
  </model>
</sdf>
