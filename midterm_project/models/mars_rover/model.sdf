<?xml version="1.0" ?>
<!--
  Mars Rover — Perseverance-inspired 6-wheel rover
  Body: 0.6m × 0.4m × 0.15m, 8 kg
  Wheels: 6 × cylinder r=0.08m w=0.05m (3 pairs: front/mid/rear)
  DiffDrive on mid wheel pair (left_mid_wheel_joint, right_mid_wheel_joint)
  360° LiDAR on top of body
  Instrument mast on top-front
  Color: Mars rover tan/white
-->
<sdf version="1.9">
  <model name="mars_rover">

    <!-- ── Chassis / Body ───────────────────────────────────────────────── -->
    <link name="base_link">
      <pose>0 0 0.075 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.084</ixx>
          <iyy>0.258</iyy>
          <izz>0.320</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.6 0.4 0.15</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.6 0.4 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.8 0.7 1</ambient>
          <diffuse>0.85 0.8 0.7 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <!-- 360 LiDAR sensor on top of body -->
      <sensor name="lidar_360" type="gpu_lidar">
        <pose>0 0 0.12 0 0 0</pose>
        <topic>rover_lidar</topic>
        <update_rate>5</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- ── Instrument Mast ──────────────────────────────────────────────── -->
    <link name="mast_link">
      <pose>0.2 0 0.225 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.00250</ixx><iyy>0.00250</iyy><izz>0.000050</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="mast_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.3</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.7 0.6 1</ambient>
          <diffuse>0.75 0.7 0.6 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="mast_joint" type="fixed">
      <parent>base_link</parent>
      <child>mast_link</child>
    </joint>

    <!-- ── Camera Head on Mast ──────────────────────────────────────────── -->
    <link name="camera_head_link">
      <pose>0.2 0 0.4 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000017</ixx><iyy>0.000017</iyy><izz>0.000017</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="head_visual">
        <geometry>
          <box><size>0.07 0.12 0.07</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.4 1</ambient>
          <diffuse>0.35 0.35 0.45 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="camera_head_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_head_link</child>
    </joint>

    <!-- ══ WHEELS ══════════════════════════════════════════════════════════
         base_link center is at z=0.075 above model origin.
         Wheel center z in model frame: 0.075 + (-0.07) = 0.005
         Wheel link pose z=0.005 => wheel center just above ground (radius=0.08)
         Wheels rotated 90deg around X so cylinder axis aligns with Y (axle).
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Front-Left Wheel -->
    <link name="front_left_wheel">
      <pose>0.22 0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- Front-Right Wheel -->
    <link name="front_right_wheel">
      <pose>0.22 -0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- Mid-Left Wheel (driven by DiffDrive) -->
    <link name="left_mid_wheel">
      <pose>0.0 0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="left_mid_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_mid_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- Mid-Right Wheel (driven by DiffDrive) -->
    <link name="right_mid_wheel">
      <pose>0.0 -0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="right_mid_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_mid_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- Rear-Left Wheel -->
    <link name="rear_left_wheel">
      <pose>-0.22 0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- Rear-Right Wheel -->
    <link name="rear_right_wheel">
      <pose>-0.22 -0.22 0.005 1.5708 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.000820</ixx><iyy>0.000820</iyy><izz>0.001600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.08</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <dynamics><damping>0.005</damping><friction>0.01</friction></dynamics>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
      </axis>
    </joint>

    <!-- ── Plugins ───────────────────────────────────────────────────────── -->

    <!-- DiffDrive on mid wheel pair -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_mid_wheel_joint</left_joint>
      <right_joint>right_mid_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>rover_odom</odom_topic>
      <odom_publish_frequency>10</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
    </plugin>

    <!-- DiffDrive on front wheel pair — 6WD: same cmd_vel, separate odom topic -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>rover_odom_front</odom_topic>
      <odom_publish_frequency>0</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link_front</child_frame_id>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
    </plugin>

    <!-- DiffDrive on rear wheel pair — 6WD: same cmd_vel, separate odom topic -->
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.44</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>rover_odom_rear</odom_topic>
      <odom_publish_frequency>0</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link_rear</child_frame_id>
      <min_velocity>-0.6</min_velocity>
      <max_velocity>0.6</max_velocity>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
    </plugin>

    <!-- Joint state publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>rover_joint_states</topic>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>left_mid_wheel_joint</joint_name>
      <joint_name>right_mid_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
