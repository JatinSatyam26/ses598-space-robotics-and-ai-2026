<?xml version="1.0" ?>
<!--
  Mars Scout Mission World — v2
  Rock layout: two staggered walls forcing the rover to navigate around.
  Rocks are taller (0.4-0.5m z-radius) so the drone detects them at 2m AGL.
  Clear corridor at y > 2.2 (rover can pass around the top).
  Drone survey lanes: y=-2,-1,0,1,2 — lane y=0 flies directly over the wall.

  (0, 0) START            Rock Wall (x=4-13)          (15, 0) DOME
  Drone + Rover           Corridor at y > 2.0 or y < -2.0
-->
<sdf version="1.9">
  <world name="mars_mission">

    <!-- ── System Plugins ──────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ── Physics ─────────────────────────────────────────────────────── -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ── Scene ───────────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.3 0.2 0.15 1</ambient>
      <background>0.55 0.35 0.25 1</background>
      <sky><time>10</time><sunrise>6</sunrise><sunset>20</sunset></sky>
    </scene>

    <!-- ── Sun ─────────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>15 -10 20 0 0.5 -0.5</pose>
      <diffuse>0.95 0.9 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -0.8</direction>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ── Mars Ground Plane ────────────────────────────────────────────── -->
    <model name="mars_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.15 1</ambient>
            <diffuse>0.7 0.35 0.18 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Habitat Dome at x=15 ─────────────────────────────────────────── -->
    <include>
      <uri>model://habitat_dome</uri>
      <name>habitat_dome</name>
      <pose>15 0 0 0 0 0</pose>
    </include>

    <!-- ══════════════════════════════════════════════════════════════════
         ROCKS v2 — Taller boulders (z-radius 0.35-0.5m) arranged in two
         staggered rows along y=-0.5..1.5 to block the direct path.
         Corridor at y > 2.3 gives the rover a route around.
         Drone y=0 and y=1 lanes fly directly over most rocks.

         Rock height (z): ~0.4-0.5m at peak (ellipsoid z-radius 0.35-0.45m
         plus partial tilt). Rangefinder at 2m AGL reads ~1.5-1.6m over
         these, triggering detection threshold (survey_alt - 0.25 = 1.75m).
    ═══════════════════════════════════════════════════════════════════════ -->

    <!-- Rock 01: x=4.0, y=0.2 — row A, blocks center -->
    <model name="rock_01">
      <static>true</static>
      <pose>4.0 0.2 0 0.1 0.2 0.8</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.45 0.35 0.42</radii></ellipsoid></geometry>
          <material><ambient>0.48 0.30 0.18 1</ambient><diffuse>0.53 0.34 0.22 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.45 0.35 0.42</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>0.2 0.15 0.15 0.4 0.1 0</pose>
          <geometry><ellipsoid><radii>0.32 0.28 0.30</radii></ellipsoid></geometry>
          <material><ambient>0.52 0.33 0.21 1</ambient><diffuse>0.57 0.37 0.25 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>0.2 0.15 0.15 0.4 0.1 0</pose>
          <geometry><ellipsoid><radii>0.32 0.28 0.30</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 02: x=4.5, y=1.3 — row B, blocks y=1 corridor -->
    <model name="rock_02">
      <static>true</static>
      <pose>4.5 1.3 0 0.2 0.1 2.1</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.50 0.38 0.45</radii></ellipsoid></geometry>
          <material><ambient>0.44 0.27 0.15 1</ambient><diffuse>0.49 0.31 0.19 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.50 0.38 0.45</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>-0.2 -0.15 0.2 0.5 0.2 1.0</pose>
          <geometry><ellipsoid><radii>0.35 0.30 0.32</radii></ellipsoid></geometry>
          <material><ambient>0.49 0.31 0.19 1</ambient><diffuse>0.54 0.35 0.23 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>-0.2 -0.15 0.2 0.5 0.2 1.0</pose>
          <geometry><ellipsoid><radii>0.35 0.30 0.32</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 03: x=6.0, y=-0.4 — row A extension -->
    <model name="rock_03">
      <static>true</static>
      <pose>6.0 -0.4 0 0.3 0.15 1.5</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.48 0.36 0.44</radii></ellipsoid></geometry>
          <material><ambient>0.46 0.29 0.17 1</ambient><diffuse>0.51 0.33 0.21 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.48 0.36 0.44</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>0.18 -0.2 0.18 0.6 0.3 0.5</pose>
          <geometry><ellipsoid><radii>0.33 0.27 0.30</radii></ellipsoid></geometry>
          <material><ambient>0.50 0.31 0.19 1</ambient><diffuse>0.55 0.35 0.23 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>0.18 -0.2 0.18 0.6 0.3 0.5</pose>
          <geometry><ellipsoid><radii>0.33 0.27 0.30</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 04: x=6.5, y=1.0 — row B continuation -->
    <model name="rock_04">
      <static>true</static>
      <pose>6.5 1.0 0 0.15 0.3 0.4</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.42 0.50 0.40</radii></ellipsoid></geometry>
          <material><ambient>0.53 0.34 0.22 1</ambient><diffuse>0.58 0.38 0.26 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.42 0.50 0.40</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>-0.15 0.22 0.22 0.3 0.5 0.8</pose>
          <geometry><ellipsoid><radii>0.30 0.35 0.28</radii></ellipsoid></geometry>
          <material><ambient>0.47 0.29 0.18 1</ambient><diffuse>0.52 0.33 0.22 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>-0.15 0.22 0.22 0.3 0.5 0.8</pose>
          <geometry><ellipsoid><radii>0.30 0.35 0.28</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 05: x=8.0, y=0.3 — midfield center blocker -->
    <model name="rock_05">
      <static>true</static>
      <pose>8.0 0.3 0 0.2 0.25 1.9</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.55 0.42 0.48</radii></ellipsoid></geometry>
          <material><ambient>0.51 0.32 0.20 1</ambient><diffuse>0.56 0.36 0.24 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.55 0.42 0.48</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>0.25 -0.3 0.25 0.7 0.2 0.3</pose>
          <geometry><ellipsoid><radii>0.38 0.32 0.35</radii></ellipsoid></geometry>
          <material><ambient>0.46 0.28 0.17 1</ambient><diffuse>0.51 0.32 0.21 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>0.25 -0.3 0.25 0.7 0.2 0.3</pose>
          <geometry><ellipsoid><radii>0.38 0.32 0.35</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 06: x=8.5, y=1.4 — row B midfield -->
    <model name="rock_06">
      <static>true</static>
      <pose>8.5 1.4 0 0.1 0.4 2.7</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.44 0.52 0.42</radii></ellipsoid></geometry>
          <material><ambient>0.43 0.26 0.15 1</ambient><diffuse>0.48 0.30 0.19 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.44 0.52 0.42</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>-0.25 0.2 0.2 0.4 0.3 1.2</pose>
          <geometry><ellipsoid><radii>0.32 0.28 0.30</radii></ellipsoid></geometry>
          <material><ambient>0.48 0.30 0.18 1</ambient><diffuse>0.53 0.34 0.22 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>-0.25 0.2 0.2 0.4 0.3 1.2</pose>
          <geometry><ellipsoid><radii>0.32 0.28 0.30</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 07: x=10.0, y=-0.2 — second wall, row A -->
    <model name="rock_07">
      <static>true</static>
      <pose>10.0 -0.2 0 0.25 0.35 0.6</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.50 0.40 0.46</radii></ellipsoid></geometry>
          <material><ambient>0.55 0.35 0.23 1</ambient><diffuse>0.60 0.39 0.27 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.50 0.40 0.46</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>0.3 0.25 0.2 0.5 0.3 0.9</pose>
          <geometry><ellipsoid><radii>0.36 0.30 0.33</radii></ellipsoid></geometry>
          <material><ambient>0.49 0.31 0.20 1</ambient><diffuse>0.54 0.35 0.24 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>0.3 0.25 0.2 0.5 0.3 0.9</pose>
          <geometry><ellipsoid><radii>0.36 0.30 0.33</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 08: x=10.5, y=1.1 — second wall, row B -->
    <model name="rock_08">
      <static>true</static>
      <pose>10.5 1.1 0 0.3 0.2 1.7</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.46 0.38 0.43</radii></ellipsoid></geometry>
          <material><ambient>0.47 0.29 0.17 1</ambient><diffuse>0.52 0.33 0.21 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.46 0.38 0.43</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>-0.2 -0.28 0.22 0.3 0.4 0.4</pose>
          <geometry><ellipsoid><radii>0.33 0.27 0.30</radii></ellipsoid></geometry>
          <material><ambient>0.51 0.32 0.20 1</ambient><diffuse>0.56 0.36 0.24 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>-0.2 -0.28 0.22 0.3 0.4 0.4</pose>
          <geometry><ellipsoid><radii>0.33 0.27 0.30</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 09: x=12.0, y=0.4 — final gate blocker -->
    <model name="rock_09">
      <static>true</static>
      <pose>12.0 0.4 0 0.2 0.4 2.3</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.52 0.44 0.48</radii></ellipsoid></geometry>
          <material><ambient>0.50 0.31 0.19 1</ambient><diffuse>0.55 0.35 0.23 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.52 0.44 0.48</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>0.28 -0.22 0.25 0.6 0.2 1.0</pose>
          <geometry><ellipsoid><radii>0.37 0.32 0.34</radii></ellipsoid></geometry>
          <material><ambient>0.45 0.28 0.16 1</ambient><diffuse>0.50 0.32 0.20 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>0.28 -0.22 0.25 0.6 0.2 1.0</pose>
          <geometry><ellipsoid><radii>0.37 0.32 0.34</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- Rock 10: x=12.5, y=1.5 — upper corridor partial blocker -->
    <model name="rock_10">
      <static>true</static>
      <pose>12.5 1.5 0 0.15 0.3 0.9</pose>
      <link name="rock_link">
        <visual name="blob_1">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.43 0.55 0.40</radii></ellipsoid></geometry>
          <material><ambient>0.44 0.27 0.16 1</ambient><diffuse>0.49 0.31 0.20 1</diffuse></material>
        </visual>
        <collision name="blob_1_col">
          <pose>0 0 0 0 0 0</pose>
          <geometry><ellipsoid><radii>0.43 0.55 0.40</radii></ellipsoid></geometry>
        </collision>
        <visual name="blob_2">
          <pose>-0.3 0.28 0.18 0.5 0.2 1.4</pose>
          <geometry><ellipsoid><radii>0.30 0.38 0.28</radii></ellipsoid></geometry>
          <material><ambient>0.49 0.30 0.18 1</ambient><diffuse>0.54 0.34 0.22 1</diffuse></material>
        </visual>
        <collision name="blob_2_col">
          <pose>-0.3 0.28 0.18 0.5 0.2 1.4</pose>
          <geometry><ellipsoid><radii>0.30 0.38 0.28</radii></ellipsoid></geometry>
        </collision>
      </link>
    </model>

    <!-- ── Flying Drone ────────────────────────────────────────────────── -->
    <include>
      <uri>model://flying_drone</uri>
      <name>drone</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <!-- ── Mars Rover ──────────────────────────────────────────────────── -->
    <include>
      <uri>model://mars_rover</uri>
      <name>rover</name>
      <pose>0 1.5 0.12 0 0 0</pose>
    </include>

  </world>
</sdf>
