<?xml version="1.0"?>
<sdf version="1.9">
  <model name="habitat_dome">
    <static>true</static>
    <link name="dome_link">
      <visual name="dome_visual">
        <geometry>
          <sphere>
            <radius>1.0</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.85 0.7 1</ambient>
          <diffuse>0.9 0.85 0.7 1</diffuse>
        </material>
      </visual>
      <collision name="dome_collision">
        <geometry>
          <sphere>
            <radius>1.0</radius>
          </sphere>
        </geometry>
      </collision>
      <!-- Sink half into ground so it looks like a hemisphere -->
      <pose>0 0 0 0 0 0</pose>
    </link>
    <!-- Flag pole on top for visibility -->
    <link name="flag_pole">
      <pose>0 0 1.0 0 0 0</pose>
      <visual name="pole_visual">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>1.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="pole_joint" type="fixed">
      <parent>dome_link</parent>
      <child>flag_pole</child>
    </joint>
  </model>
</sdf>
